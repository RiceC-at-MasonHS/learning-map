{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Lesson plan (ordered route through the graph)",
  "type": "object",
  "required": ["plan"],
  "additionalProperties": false,
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "anyRef": { "type": "string", "pattern": "^([a-z0-9]+(-[a-z0-9]+)*|[a-z][a-z0-9-]*:[0-9A-Za-z.]+)$" }
  },
  "properties": {
    "plan": {
      "type": "object",
      "required": ["id", "title", "course", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string" },
        "course": { "$ref": "#/$defs/slug" },
        "author": { "type": "string" },
        "status": { "enum": ["draft", "active", "archived"] },
        "initial_reveal": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "standards_to_zoom": { "type": "integer", "minimum": 0, "maximum": 4 },
            "nodes": { "type": "array", "items": { "$ref": "#/$defs/anyRef" } }
          }
        },
        "infrastructure": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "title"], "additionalProperties": false,
            "properties": { "id": { "$ref": "#/$defs/slug" }, "title": { "type": "string" }, "notes": { "type": "string" } }
          }
        },
        "steps": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "sync"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "title": { "type": "string" },
              "sync": { "type": "boolean" },
              "experiences": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
              "choices": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
              "min_choices": { "type": "integer", "minimum": 1 },
              "reveals": { "type": "array", "items": { "$ref": "#/$defs/anyRef" } },
              "notes": { "type": "string" }
            },
            "if": { "properties": { "sync": { "const": true } } },
            "then": { "required": ["experiences"], "not": { "required": ["choices"] } },
            "else": { "required": ["choices"] }
          }
        }
      }
    }
  }
}
